@model CourseRegistrationApp.Models.CourseRegistration

@{
    ViewData["Title"] = "Course Registration";
}

<h2>Course Registration</h2>

<form asp-controller="Registration" asp-action="Index" method="post">

    <div>
        <label asp-for="StudentName">Student Name</label>
        <input asp-for="StudentName" />
        <span asp-validation-for="StudentName"></span>
    </div>

    <br />

    <div>
        <label asp-for="Course">Course</label>
        <select asp-for="Course">
            <option value="">Select course</option>
            <option value="C#">C#</option>
            <option value="ASP.NET Core">ASP.NET Core</option>
            <option value="SQL">SQL</option>
        </select>
        <span asp-validation-for="Course"></span>
    </div>

    <br />

    <button type="submit">Register</button>

</form>